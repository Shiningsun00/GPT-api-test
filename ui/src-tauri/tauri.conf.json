{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workflow Studio",
  "version": "2.0.0",
  "identifier": "com.shiningsun00.agentworkflowstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Workflow Studio 2.0",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aws2-backend"]
  }
}
